PORT=9999
# MongoDB Atlas or a replica set is required for payment transactions.
MONGO_URI=mongodb://127.0.0.1:27017/cinema_db?replicaSet=rs0
JWT_SECRET=replace-with-a-long-random-secret

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="Cinema <your-email@gmail.com>"

# Receiving bank account linked to SePay. Keep the account number as a string.
SEPAY_ACCOUNT_NUMBER=0123456789
# Bank code/bin/short name accepted by VietQR, e.g. MB, VCB, 970422.
SEPAY_BANK=MB
SEPAY_ACCOUNT_NAME=NGUYEN VAN A
# Match the API Key configured for this webhook, not your SePay bank API token.
SEPAY_WEBHOOK_API_KEY=replace-with-your-webhook-api-key
